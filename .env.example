# API Keys (required secrets - set these in .env.local or your deployment environment)

# Anthropic API key for Claude models (parse, plan, repair, agent)
ANTHROPIC_API_KEY=replace-me

# Google Places API key for venue search and details.
# The same key authenticates Routes API computeRouteMatrix (X-Goog-Api-Key).
# Enable the Routes API on this key's Google Cloud project and allow it in
# the key's API restrictions.
GOOGLE_PLACES_API_KEY=replace-me

# Maps JavaScript API key for the browser map only. Restrict it to the Maps
# JavaScript API and to your HTTP referrers. Do not put GOOGLE_PLACES_API_KEY
# here. Leave this unset to keep the map off. The home page still loads.
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=replace-me

# Datadog LLM Observability (decision #42). dd-trace reads only
# DD_API_KEY; config refuses a DATADOG_API_KEY set without it. Without
# DD_API_KEY the tracer uses a no-op exporter: no network, no throw. Do not
# put a real key in the repo or CI.
# With a key, each model call's prompt and reply go to Datadog as LLM Obs
# input and output, and each request's redacted text and emitted venues
# go on its workflow span. The tracer starts itself from instrumentation.ts
# (server) and evaluation/run.ts (eval); do not add dd-trace to NODE_OPTIONS.
# DD_API_KEY=replace-me
# DD_SITE=datadoghq.com
# DD_LLMOBS_ENABLED=true
# DD_LLMOBS_ML_APP=nightcap
# DD_LLMOBS_AGENTLESS_ENABLED=true

# HMAC-SHA256 key for the request hash attached to Datadog spans.
# Required in production (server start refuses the marked dev/test key).
# Dev and test fall back to a marked no-op/test key when this is unset.
# REQUEST_HASH_SECRET=replace-me-with-a-long-random-string

# Model IDs (optional - defaults provided)

# Model for parse_intent stage (default: claude-haiku-5-5)
# PARSE_MODEL_ID=claude-haiku-5-5

# Model for plan_itineraries stage (default: claude-haiku-5-5)
# PLAN_MODEL_ID=claude-haiku-5-5

# Model for repair_itinerary stage (default: claude-haiku-5-5)
# REPAIR_MODEL_ID=claude-haiku-5-5

# Model for refinement agent (default: claude-haiku-5-5)
# AGENT_MODEL_ID=claude-haiku-5-5

# Anthropic SDK client (optional - defaults provided)

# Per-attempt request timeout in ms (integer 1000-300000, default: 45000).
# Keep (timeout x (retries + 1)) under the serverless function limit.
# ANTHROPIC_TIMEOUT_MS=45000

# SDK retries on connection errors, 408/409/429 and 5xx (integer 0-5, default: 1)
# ANTHROPIC_MAX_RETRIES=1

# Cache Configuration (optional - defaults provided)

# Places coordinate cache TTL in days (default: 30, max 30).
# place_id is stored indefinitely; hours/price/rating/names are fetched live.
# PLACES_COORDS_CACHE_TTL_DAYS=30

# Places retrieval (optional - defaults provided; decision-log #33)

# Places Text Search timeout per HTTP request in ms (integer 100-30000, default: 5000)
# PLACES_TIMEOUT_MS=5000

# Wait before the single retry after a Places 429 or timeout, in ms (0-5000, default: 300)
# PLACES_RETRY_DELAY_MS=300

# Max logical Text Searches per request: 1 combined + refills (1-4, default: 2).
# Each search is $0.035 (Enterprise SKU).
# PLACES_MAX_SEARCHES_PER_REQUEST=2

# Candidates kept per stop type after re-rank (1-20, default: 5)
# RETRIEVAL_TOP_K=5

# Refill a stop type with a targeted search when fewer survive (1-TOP_K, default: 3)
# RETRIEVAL_MIN_PER_STOP=3

# A venue must be open this many contiguous minutes inside the slot (15-240, default: 60)
# RETRIEVAL_MIN_OPEN_MINUTES=60

# Re-rank weight for vibe-tag fit (0-10, default: 1)
# RERANK_VIBE_WEIGHT=1

# Re-rank weight for the review-count novelty penalty (0-10, default: 0.5)
# RERANK_POPULARITY_WEIGHT=0.5

# Review count above which the novelty penalty starts (integer >= 1, default: 2000)
# RERANK_REVIEW_SOFT_CAP=2000

# Rate Limits (optional - defaults provided)

# Max requests per hour per IP address (default: 5)
# RATE_LIMIT_REQUESTS_PER_HOUR=5

# Daily spend cap in USD across all requests (default: 5)
# RATE_LIMIT_DAILY_SPEND_USD=5

# Upstash Redis REST. When both are set, the hour counter and the daily spend
# ledger are shared across instances. When either is unset, this process keeps
# them in memory. Set both before any public demo of POST /api/plan.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Postgres for persisted plans and the places_cache coordinate adapter.
# Use the Supabase direct or pooler connection string. SUPABASE_DB_URL is
# accepted when DATABASE_URL is unset. With neither set, plans still stream
# and coordinates stay the live Text Search values.
# DATABASE_URL=
# SUPABASE_DB_URL=

# Validation Caps (optional - defaults provided)

# Max travel time between stops in minutes (default: 25)
# TRAVEL_CAP_MINUTES=25

# Routes computeRouteMatrix timeout in milliseconds (default: 5000)
# ROUTES_API_TIMEOUT_MS=5000

# Allowed |claimed − computed| travel minutes before travel_mismatch (default: 5)
# TRAVEL_CLAIM_TOLERANCE_MINUTES=5

# Wall-clock budget for one validation's travel calls in ms (default: 6000).
# Exhausted budget fails closed as travel_service_unavailable.
# TRAVEL_BUDGET_MS=6000

# Live Google Routes computeRouteMatrix. Default off in dev/test.
# Unit tests and eval use a fake or recorded calculator.
# Accepts only true/false/1/0; any other value throws.
# Production refuses to start unless ENABLE_LIVE_ROUTES=true and
# GOOGLE_PLACES_API_KEY is set. Runtime outages use travel_service_unavailable.
# ENABLE_LIVE_ROUTES=false

# Heuristic per-person USD ranges for PRICE_LEVEL_* checks. Not from Google.
# estimatedCostUsd is the stop's total for the whole party; the validator
# compares estimatedCostUsd / partySize (default 2) to these ranges.
# Format min,max. min must not exceed max.
# PRICE_RANGE_FREE=0,0
# PRICE_RANGE_INEXPENSIVE=0,40
# PRICE_RANGE_MODERATE=20,120
# PRICE_RANGE_EXPENSIVE=80,250
# PRICE_RANGE_VERY_EXPENSIVE=150,1000

# Max tool calls per agent turn (default: 6)
# AGENT_MAX_TOOL_CALLS=6

# Max cost in USD per agent turn (default: 0.08)
# AGENT_MAX_COST_USD_PER_TURN=0.08

# Max repair rounds before dropping an option (default: 2)
# REPAIR_MAX_ROUNDS=2

# Max travel legs per request, summed across options (integer 2–9, default: 4).
# An option's legs are its stops minus 1; a single-stop option has 0.
# MAX_TRAVEL_LEGS_PER_REQUEST=4
