# API Keys (required secrets - set these in .env.local or your deployment environment)

# Anthropic API key for Claude models (parse, plan, repair, agent)
ANTHROPIC_API_KEY=replace-me

# Google Places API key for venue search and details.
# The same key authenticates Routes API computeRouteMatrix (X-Goog-Api-Key).
# Enable the Routes API on this key's Google Cloud project and allow it in
# the key's API restrictions.
GOOGLE_PLACES_API_KEY=replace-me

# Datadog API key for LLM observability traces
DATADOG_API_KEY=replace-me

# Cloudflare Turnstile secret key for captcha verification
TURNSTILE_SECRET_KEY=replace-me

# Model IDs (optional - defaults provided)

# Model for parse_intent stage (default: claude-haiku-4-5)
# PARSE_MODEL_ID=claude-haiku-4-5

# Model for plan_itineraries stage (default: claude-sonnet-5)
# PLAN_MODEL_ID=claude-sonnet-5

# Model for repair_itinerary stage (default: claude-sonnet-5)
# REPAIR_MODEL_ID=claude-sonnet-5

# Model for refinement agent (default: claude-sonnet-5)
# AGENT_MODEL_ID=claude-sonnet-5

# Cache Configuration (optional - defaults provided)

# Places cache TTL in hours (default: 24)
# PLACES_CACHE_TTL_HOURS=24

# Rate Limits (optional - defaults provided)

# Max requests per hour per IP address (default: 5)
# RATE_LIMIT_REQUESTS_PER_HOUR=5

# Daily spend cap in USD across all requests (default: 5)
# RATE_LIMIT_DAILY_SPEND_USD=5

# Validation Caps (optional - defaults provided)

# Max travel time between stops in minutes (default: 25)
# TRAVEL_CAP_MINUTES=25

# Routes computeRouteMatrix timeout in milliseconds (default: 5000)
# ROUTES_API_TIMEOUT_MS=5000

# Allowed |claimed − computed| travel minutes before travel_mismatch (default: 5)
# TRAVEL_CLAIM_TOLERANCE_MINUTES=5

# Wall-clock budget for one validation's travel calls in ms (default: 6000).
# Exhausted budget fails closed as travel_service_unavailable.
# TRAVEL_BUDGET_MS=6000

# Live Google Routes computeRouteMatrix. Default off in dev/test.
# Unit tests and eval use a fake or recorded calculator.
# Accepts only true/false/1/0; any other value throws.
# Production refuses to start unless ENABLE_LIVE_ROUTES=true and
# GOOGLE_PLACES_API_KEY is set. Runtime outages use travel_service_unavailable.
# ENABLE_LIVE_ROUTES=false

# Heuristic per-person USD ranges for PRICE_LEVEL_* checks. Not from Google.
# estimatedCostUsd is the stop's total for the whole party; the validator
# compares estimatedCostUsd / partySize (default 2) to these ranges.
# Format min,max. min must not exceed max.
# PRICE_RANGE_FREE=0,0
# PRICE_RANGE_INEXPENSIVE=0,40
# PRICE_RANGE_MODERATE=20,120
# PRICE_RANGE_EXPENSIVE=80,250
# PRICE_RANGE_VERY_EXPENSIVE=150,1000

# Max tool calls per agent turn (default: 6)
# AGENT_MAX_TOOL_CALLS=6

# Max cost in USD per agent turn (default: 0.03)
# AGENT_MAX_COST_USD_PER_TURN=0.03

# Max repair rounds before dropping an option (default: 2)
# REPAIR_MAX_ROUNDS=2

# Max travel legs per request, summed across options (integer 2–9, default: 4).
# An option's legs are its stops minus 1; a single-stop option has 0.
# MAX_TRAVEL_LEGS_PER_REQUEST=4
