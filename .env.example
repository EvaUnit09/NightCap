# API Keys (required secrets - set these in .env.local or your deployment environment)

# Anthropic API key for Claude models (parse, plan, repair, agent)
ANTHROPIC_API_KEY=sk-ant-xxx

# Google Places API key for venue search and details
GOOGLE_PLACES_API_KEY=AIzaSyXXX

# Datadog API key for LLM observability traces
DATADOG_API_KEY=xxx

# Cloudflare Turnstile secret key for captcha verification
TURNSTILE_SECRET_KEY=0x4XXX

# Model IDs (optional - defaults provided)

# Model for parse_intent stage (default: claude-haiku-4.5)
# PARSE_MODEL_ID=claude-haiku-4.5

# Model for plan_itineraries stage (default: claude-sonnet-5)
# PLAN_MODEL_ID=claude-sonnet-5

# Model for repair_itinerary stage (default: claude-sonnet-5)
# REPAIR_MODEL_ID=claude-sonnet-5

# Model for refinement agent (default: claude-sonnet-5)
# AGENT_MODEL_ID=claude-sonnet-5

# Cache Configuration (optional - defaults provided)

# Places cache TTL in hours (default: 24)
# PLACES_CACHE_TTL_HOURS=24

# Rate Limits (optional - defaults provided)

# Max requests per hour per IP address (default: 5)
# RATE_LIMIT_REQUESTS_PER_HOUR=5

# Daily spend cap in USD across all requests (default: 100)
# RATE_LIMIT_DAILY_SPEND_USD=100

# Validation Caps (optional - defaults provided)

# Max travel time between stops in minutes (default: 25)
# TRAVEL_CAP_MINUTES=25

# Max tool calls per agent turn (default: 6)
# AGENT_MAX_TOOL_CALLS=6

# Max cost in USD per agent turn (default: 0.03)
# AGENT_MAX_COST_USD_PER_TURN=0.03

# Max repair rounds before dropping an option (default: 2)
# REPAIR_MAX_ROUNDS=2
